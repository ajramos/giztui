### **Keyboard Handling in Prompt**

```go
func (p *Prompt) keyboard(evt *tcell.EventKey) *tcell.EventKey {
    m, ok := p.model.(Suggester)
    if !ok {
        return evt
    }

    switch evt.Key() {
    case tcell.KeyBackspace, tcell.KeyDelete:
        p.model.Delete()                    // Delete character

    case tcell.KeyRune:
        p.model.Add(evt.Rune())            // Add character

    case tcell.KeyEscape:
        p.model.ClearText(true)            // Cancel command
        p.model.SetActive(false)

    case tcell.KeyEnter:
        p.model.SetText(p.model.GetText(), "") // Execute command
        p.model.SetActive(false)

    case tcell.KeyUp:
        if s, ok := m.NextSuggestion(); ok {   // ↑ next suggestion
            p.model.SetText(p.model.GetText(), s)
        }

    case tcell.KeyDown:
        if s, ok := m.PrevSuggestion(); ok {   // ↓ previous suggestion
            p.model.SetText(p.model.GetText(), s)
        }

    case tcell.KeyTab, tcell.KeyRight:
        if s, ok := m.CurrentSuggestion(); ok { // → auto-complete
            p.model.SetText(p.model.GetText()+s, "")
            m.ClearSuggestions()
        }
    }

    return nil
}
```

## 🧠 Command Interpreter System

### **Interpreter Structure**

```go
// internal/view/cmd/interpreter.go
type Interpreter struct {
    line string    // Full command line
    cmd  string    // Main command
    args args      // Parsed arguments
}

// Main parsing
func (c *Interpreter) grok() {
    ff := strings.Fields(c.line)  // Split by spaces
    if len(ff) == 0 {
        return
    }
    c.cmd = strings.ToLower(ff[0])     // Command in lowercase
    c.args = newArgs(c, ff[1:])        // Parse arguments
}
```

### **Argument Parsing**

```go
// internal/view/cmd/args.go
const (
    nsKey      = "ns"       // Namespace: -n default
    filterKey  = "filter"   // Filter: /pattern
    fuzzyKey   = "fuzzy"    // Fuzzy: -f pattern
    labelKey   = "labels"   // Labels: key=value
    contextKey = "context"  // Context: @context-name
)

func newArgs(p *Interpreter, aa []string) args {
    arguments := make(args, len(aa))

    for i := 0; i < len(aa); i++ {
        a := strings.TrimSpace(aa[i])

        switch {
        case strings.Index(a, "-f") == 0:      // Fuzzy search
            arguments[fuzzyKey] = a[2:]

        case strings.Index(a, "/") == 0:       // Filter
            arguments[filterKey] = a[1:]

        case strings.Contains(a, "="):         // Labels
            arguments[labelKey] = a

        case strings.Index(a, "@") == 0:       // Context
            arguments[contextKey] = a[1:]

        default:                               // Namespace or resource
            arguments[nsKey] = strings.ToLower(a)
        }
    }

    return arguments
}
```

